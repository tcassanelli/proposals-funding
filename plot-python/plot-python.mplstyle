# LINES
lines.linewidth     : 0.5
lines.markersize    : 5

# TEXT
# font.family + font.sans-serif handle Verdana directly (no LaTeX dependency).
# For exact LaTeX math rendering, use pgf backend with lualatex instead.
text.usetex         : False

# FONT
font.family         : sans-serif
font.sans-serif     : Verdana, DejaVu Sans, Arial, Helvetica
font.size           : 11

# AXES
axes.labelsize      : 8
axes.linewidth      : 0.4
axes.titlesize      : 11
axes.grid           : True

axes.prop_cycle     : cycler('color', ['1f2db4', 'b41f2d', '1fb4a6', 'b4a61f'])

patch.linewidth     : 0.5

# TICKS
xtick.labelsize     : 8
ytick.labelsize     : 8
xtick.major.width   : 0.4
xtick.minor.width   : 0.4
ytick.major.width   : 0.4
ytick.minor.width   : 0.4

# IMAGES
image.cmap          : viridis
image.origin        : lower
image.aspect        : auto

# GRIDS
grid.linestyle      : --
grid.alpha          : 0.6
grid.linewidth      : 0.4
grid.color          : b0b0b0

# FIGURE
figure.titlesize    : 11
figure.dpi          : 200
figure.figsize      : 6.93, 4.28  # textwidth x textwidth/golden-ratio (letterpaper, 2 cm margins)

# LEGEND
legend.fontsize     : 8
legend.fancybox     : False
legend.borderpad    : 0.4
legend.frameon      : True

# SAVING FIGURES
savefig.bbox        : tight
savefig.pad_inches  : 0.03
